# Ensure PHP files are executed by the server instead of being downloaded
<IfModule mod_mime.c>
    AddHandler application/x-httpd-php .php .phtml
</IfModule>

<IfModule mod_php.c>
    php_flag engine on
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule (^|/)\.git(?:/|$) - [F,L,NC]
</IfModule>

# Application includes can still read these files from disk.
# Mirror these rules in nginx when it serves static files directly.
<FilesMatch "(?i)(^\.env(?:\..*)?$|\.(?:sql|sqlite3?|log|bak)$)">
    Require all denied
</FilesMatch>
