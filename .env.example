# Database Configuration
DB_HOST=localhost
DB_NAME=defect_tracker
DB_USERNAME=defect_tracker
DB_PASSWORD=replace-with-a-strong-unique-password

# Application Configuration
BASE_URL=https://mcgoff.defecttracker.uk/
SITE_URL=https://mcgoff.defecttracker.uk/

# Legacy backup utility (if enabled)
BACKUP_USERNAME=admin
BACKUP_PASSWORD=replace-with-a-strong-unique-password

# Email Configuration
EMAIL_FROM=noreply@your-domain.com

# Upload Configuration
UPLOAD_PATH=/uploads/
MAX_FILE_SIZE=5242880
ALLOWED_FILE_TYPES=jpg,jpeg,png,pdf

# Security
CSRF_TOKEN_EXPIRES=3600
SESSION_TIMEOUT=1800

# Environment (development, production)
ENVIRONMENT=production

# Logging
LOG_LEVEL=error

# Push Notifications (Firebase Cloud Messaging)
FIREBASE_SERVER_KEY=YOUR_FIREBASE_SERVER_KEY_HERE
